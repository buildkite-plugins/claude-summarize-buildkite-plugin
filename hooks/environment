#!/bin/bash
set -euo pipefail

# Load plugin bash library
DIR="$(cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd)"
# shellcheck source=lib/plugin.bash
. "$DIR/../lib/plugin.bash"

# Get configuration - let shell handle command substitution and variable expansion
API_KEY=$(plugin_read_config API_KEY "")

echo "all environment variables:"
printenv | sort

echo "--- :key: Claude Code Plugin (Environment Hook)"
echo "FAKE API KEY = ${API_KEY}"

# Export API key if provided
if [[ -n "$API_KEY" ]]; then
  export BUILDKITE_PLUGIN_CLAUDE_SUMMARIZE_API_KEY="$API_KEY"
fi

# Use ANTHROPIC_API_KEY if set
if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
  echo "Using ANTHROPIC_API_KEY from environment"
  export BUILDKITE_PLUGIN_CLAUDE_SUMMARIZE_API_KEY="${ANTHROPIC_API_KEY}"
fi
